<?xml version="1.0" encoding="utf-8"?>
<!-- WAZNE: ani android:focusable, ani android:clickable.
     ListView odpala klikniecie elementu tylko wtedy, gdy wiersz NIE jest
     focusable i sam nie "zjada" dotkniecia. Klikniecie obsluguje
     setPendingIntentTemplate (na ListView) + setOnClickFillInIntent (na wierszu). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_row_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/row_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/widget_check_off" />

    <TextView
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#EDEDE6"
        android:textSize="14sp" />

</LinearLayout>
